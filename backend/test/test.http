###############################################
# 6. ADMIN BROADCAST ENDPOINTS
###############################################

### Send Telegram to All Admins
POST @baseUrl/api/notifications/logs/send_to_all_admins_telegram/
Content-Type: @contentType
Authorization: Bearer @token

{
    "title": "System Maintenance Alert",
    "message": "The system will be under maintenance tonight from 11 PM to 1 AM. Please plan accordingly."
}

### Send Email to All Admins
POST @baseUrl/api/notifications/logs/send_to_all_admins_email/
Content-Type: @contentType
Authorization: Bearer @token

{
    "title": "Daily Support Report",
    "message": "Today's support metrics are ready for review. Please check the dashboard for details."
}

